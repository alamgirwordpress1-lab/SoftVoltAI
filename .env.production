# Public, non-secret settings every production build needs, committed so a fresh
# clone builds against WordPress without a hand-made .env.local. Without
# WP_GRAPHQL_URL a build silently falls back to the sample content in /content
# (one product, the demo case studies, an empty blog) and bakes it into the
# static pages. These match the "vars" in wrangler.jsonc. Secrets (API keys,
# WP_PREVIEW_SECRET, webhook secrets) never go here: they live in the
# Cloudflare dashboard, and in .env.local on your own machine.
NEXT_PUBLIC_SITE_URL=https://www.softvoltai.com
WP_GRAPHQL_URL=https://cms.softvoltai.com/graphql
WP_REST_URL=https://cms.softvoltai.com/wp-json
CF7_BASE_URL=https://cms.softvoltai.com
CF7_BRIEF_FORM_ID=145
CF7_CONTACT_FORM_ID=146
BRIEF_TO_EMAIL=hello@softvoltai.com
BRIEF_FROM_EMAIL=briefs@softvoltai.com
WP_REVALIDATE_SECONDS=86400
