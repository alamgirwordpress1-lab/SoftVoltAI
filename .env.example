# Public site origin — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.softvoltai.com

# Cal.com booking link shown next to the brief form (e.g. https://cal.com/softvoltai/scoping-call)
NEXT_PUBLIC_CAL_URL=

# Volt, the AI sales assistant (/api/volt). No key hides it.
DEEPSEEK_API_KEY=
# Optional; defaults to deepseek-v4-pro
DEEPSEEK_MODEL=
# The n8n "Lead handler" webhook that saves bookings and hot leads and alerts the admin
VOLT_LEADS_WEBHOOK_URL=
# Sent as the x-volt-secret header; must match the Header Auth credential on that webhook
VOLT_LEADS_WEBHOOK_SECRET=

# Brief form delivery via Resend. Leave empty in development: submissions are logged to the server console instead.
RESEND_API_KEY=
BRIEF_TO_EMAIL=hello@softvoltai.com
BRIEF_FROM_EMAIL=briefs@softvoltai.com

# Headless Contact Form 7 (optional). Set all three and both forms deliver through
# WordPress instead of Resend; leave them empty and nothing changes. The two forms
# already exist on the CMS: "Project brief (order form)" and "Contact enquiry".
CF7_BASE_URL=
CF7_BRIEF_FORM_ID=
CF7_CONTACT_FORM_ID=
# Sent with each submission so CF7 answers in the same locale the form was built in. Default en_GB.
CF7_LOCALE=en_GB

# Headless WordPress. With WP_GRAPHQL_URL empty the site runs on the typed
# content in /content, which is how it ships until the CMS has the content.
WP_GRAPHQL_URL=
WP_REST_URL=
# Shared with the WordPress settings screen: revalidation and previews both use it.
WP_PREVIEW_SECRET=
# How long a cached WordPress read is served before it refreshes (seconds).
WP_REVALIDATE_SECONDS=3600
