# Public site origin — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://softvoltai.com

# Cal.com booking link shown next to the brief form (e.g. https://cal.com/softvoltai/scoping-call)
NEXT_PUBLIC_CAL_URL=

# Brief form delivery via Resend. Leave empty in development: submissions are logged to the server console instead.
RESEND_API_KEY=
BRIEF_TO_EMAIL=hello@softvoltai.com
BRIEF_FROM_EMAIL=briefs@softvoltai.com

# Headless Contact Form 7 (optional). Set all three and both forms deliver through
# WordPress instead of Resend; leave them empty and nothing changes.
CF7_BASE_URL=
CF7_BRIEF_FORM_ID=
CF7_CONTACT_FORM_ID=
