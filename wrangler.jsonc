{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softvoltai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference, used by the OpenNext cache to call back into this worker.
    // The service name must match "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "softvoltai" }
  ],
  // Page and data cache (Workers KV namespace "softvoltai-next-cache").
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "34ea6a89171b498282f11644968ad272" }],
  // Cache tags for on-demand revalidation from WordPress.
  "d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "softvoltai-tag-cache", "database_id": "bf8f8f58-f856-4bac-8d7e-ed97bf1c7214" }],
  // Background revalidation queue.
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // next/image optimisation through Cloudflare Images.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // Keep variables added in the dashboard (Settings > Variables and Secrets) on deploy.
  "keep_vars": true,
  // Public settings. Secrets (API keys, WP_PREVIEW_SECRET, webhook secrets) are set
  // in the Cloudflare dashboard as encrypted secrets, never here.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.softvoltai.com",
    "WP_GRAPHQL_URL": "https://cms.softvoltai.com/graphql",
    "WP_REST_URL": "https://cms.softvoltai.com/wp-json",
    // WordPress pushes every save to /api/revalidate, so the timed refresh is only a
    // safety net. A day keeps Workers KV under its free 1,000 writes a day.
    "WP_REVALIDATE_SECONDS": "86400"
  }
}
